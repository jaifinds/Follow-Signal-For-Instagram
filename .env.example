# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for OAuth callbacks and API endpoints.
# Local Dev: http://localhost:3000
# Production: https://your-domain.com
APP_URL="http://localhost:3000"

# ==============================================================================
# OFFICIAL META INSTAGRAM OAUTH CONFIGURATION
# ==============================================================================
# 1. Create a Meta Developer App at https://developers.facebook.com/
# 2. Select use case: "Business" or "Other"
# 3. Add product: "Instagram API with Instagram Login"
# 4. Under Instagram Settings, add Valid OAuth Redirect URIs:
#    - Local: http://localhost:3000/api/instagram/callback
#    - Production: https://<YOUR_DEPLOYED_DOMAIN>/api/instagram/callback
# 5. Note: Meta Graph API requires an eligible Instagram Business or Creator account.
# ==============================================================================

# INSTAGRAM_APP_ID: Meta App ID found in App Dashboard > Settings > Basic
INSTAGRAM_APP_ID=""

# INSTAGRAM_APP_SECRET: Meta App Secret found in App Dashboard > Settings > Basic
# NEVER expose this in client-side code or git commits. Handled exclusively on server.ts.
INSTAGRAM_APP_SECRET=""

# INSTAGRAM_REDIRECT_URI: The exact redirect URI configured in Meta Developer Dashboard.
# Optional if APP_URL is set (defaults to ${APP_URL}/api/instagram/callback)
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/instagram/callback"

# SESSION_SECRET: Secret used to sign session cookies for OAuth CSRF validation
SESSION_SECRET="your-random-32-char-session-secret"
